{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile and learning statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-z0-9_]{3,30}$" },
        "displayName": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 250 },
        "profileImageUrl": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 200 },
        "classLevel": { "type": "string", "maxLength": 20 },
        "xp": { "type": "number" },
        "rank": { "type": "number" },
        "streak": { "type": "number" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique mapping of username to user uid to enforce uniqueness",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-z0-9_]{3,30}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private user account information accessible only by the account owner",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/private/info": {
      "schema": "UserPrivateInfo",
      "description": "Private user account info"
    },
    "/usernames/{username}": {
      "schema": "UsernameClaim",
      "description": "Unique username registry"
    }
  }
}
